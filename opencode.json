{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "terraform": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "hashicorp/terraform-mcp-server:1.3.0"
        ],
        "disabled": false
      },
      "terraform-best-practices": {
        "type": "remote",
        "url": "https://www.terraform-best-practices.com/~gitbook/mcp",
        "disabled": false
      },
      "aws-knowledge": {
        "type": "remote",
        "url": "https://knowledge-mcp.global.api.aws",
        "disabled": false
      }
    }
  }
}
